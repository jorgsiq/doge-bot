    "discord.js": "^14.28.0",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "opusscript": "^0.0.8"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
