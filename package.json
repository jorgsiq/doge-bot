{
  "name": "doge-bot",
  "version": "2.0.1",
  "description": "Bot do servidor Đoge Style",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
